# /srv/backup/backup.env (chmod 600): read by backup.sh. Keep the restic password ALSO in your password manager:
# without it the backups cannot be read.
RESTIC_REPOSITORY=b2:your-bucket:/home-server
RESTIC_PASSWORD_FILE=/srv/backup/restic-password
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=
# health-tracker (container and database names from its docker-compose.yml)
HEALTH_PG_CONTAINER=health-postgres
HEALTH_PG_USER=health
HEALTH_PG_DB=health
# stock-tracker (the bind-mounted data folder)
STOCK_DATA_DIR=/srv/stock/data
STOCK_AUTH_CONFIG=/srv/stock/data/auth_config.yaml
BACKUP_STAGING=/srv/backup/staging
