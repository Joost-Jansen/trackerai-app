# stock-tracker: environment for docker-compose.yml (and a reference for Railway).
# Copy to ".env" next to docker-compose.yml, fill in, chmod 600 .env.
# ".env" is in .gitignore: NEVER commit it. Keep the secrets in a password
# manager as well, not only on the server. Details: docs/SELF_HOSTING.md.

# --- Required secrets ---------------------------------------------------------

# Encrypts bank-connection keys and sessions and two-step login secrets. The API
# refuses to start without it. Existing server: take over the key the app made
# itself, so nothing needs to be uploaded again:
#   APP_ENCRYPTION_KEY=$(cat data/.encryption_key)
# New server:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=

# The shared trackerai account (packages/accounts/README.md): the same four
# values on every tracker's backend.
# The accounts database (Postgres; every tracker must reach it).
ACCOUNTS_DATABASE_URL=
# Signs the session cookie; at least 32 characters. Changing it logs everyone out.
#   python -c "import secrets; print(secrets.token_hex(32))"
ACCOUNTS_SESSION_SECRET=
# Encrypts the two-step login secrets (a Fernet key, as above).
ACCOUNTS_ENCRYPTION_KEY=
# The shared parent domain, so one login holds on every tracker (e.g.
# trackerai.nl). Empty: this host only.
SESSION_COOKIE_DOMAIN=
# Who must use two-step login: shared (admins and anyone using more than one
# tracker; default), all, admins, off.
REQUIRE_TOTP=shared
# Two-step login by email (packages/accounts): the same mail provider in every tracker.
# Resend HTTPS works on Railway Hobby. Use a sending-only key for the verified sender domain.
RESEND_API_KEY=
MAIL_FROM=
# Or SMTP on hosts that allow it. No provider configured: only the authenticator app.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- Public URL and proxy -------------------------------------------------------

# The site's own public origin(s), comma-separated (stock- and wealth-tracker
# on one API). Used by the CSRF origin check and for the bank's return address.
PUBLIC_ORIGINS=https://stocks.example.org
# The contact address EDGAR (SEC filings) requires in every request; without it EDGAR may refuse them.
SEC_CONTACT_EMAIL=
# Proxies whose forwarding headers (CF-Connecting-IP, X-Forwarded-For) are
# believed, as IPs/CIDRs. Behind the shared edge: the "edge" network's subnet.
# Empty: nobody's; every request counts as its socket peer.
TRUSTED_PROXIES=172.30.0.0/24

# --- Privacy --------------------------------------------------------------------

# Who runs this installation (the GDPR controller) and how to reach them; shown
# on /privacy.
PRIVACY_CONTROLLER=
PRIVACY_CONTACT=

# --- Limits -----------------------------------------------------------------------

# "Stay logged in": days a session lasts after its last use; renewed while in use.
SESSION_DAYS=30
# Largest uploaded file, in MB (DeGiro and bank exports).
MAX_UPLOAD_MB=10
# Days an imported file is kept; 0 deletes it right after a successful import.
UPLOAD_RETENTION_DAYS=0
# Memory ceilings for the containers (the 1.3 GB Raspberry Pi: API_MEM_LIMIT=512m).
API_MEM_LIMIT=1g
WEB_MEM_LIMIT=512m

# --- Integrations ---------------------------------------------------------------

# Optional Claude labelling suggestions (still off per user until they opt in).
ANTHROPIC_API_KEY=
# News feeds; without a Finnhub key news comes from Yahoo Finance.
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=
# Higher rate limit for ISIN-to-ticker lookups.
OPENFIGI_API_KEY=
# ntfy topic for "a position cannot be priced" and new feedback (never its text).
NTFY_TOPIC_URL=
# Another Enable Banking endpoint (sandbox).
ENABLEBANKING_API_URL=
# Only for the very first start on an empty data folder: creates this admin with
# self sign-up closed. Remove ADMIN_PASSWORD after the first login.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Only for the original Raspberry Pi setup (compose profile "pi"): its own tunnel.
TUNNEL_TOKEN=
# Pinned versions of the third-party images of the "pi" profile.
CADDY_VERSION=2.11.7
CLOUDFLARED_VERSION=2026.10.0

# --- Development only -------------------------------------------------------------

# Never in production. Allows a missing APP_ENCRYPTION_KEY (a key file in the
# data folder is used instead).
# ALLOW_INSECURE_DEFAULTS=true
# Session cookie over plain http (local development).
# COOKIE_SECURE=false
