{
  "name": "trackerai",
  "private": true,
  "description": "trackerai.nl, health-tracker, wealth-tracker and tabstealth with their shared packages; one npm workspace and one lockfile.",
  "workspaces": [
    "health-tracker/web",
    "wealth-tracker/frontend",
    "trackerai/web",
    "tabstealth/web",
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.3",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript-eslint": "8.72.0"
  }
}
