{
  "name": "@trackerai/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared frontend code for both apps: design system, primitives, helpers. Shipped as source; each app transpiles it (transpilePackages).",
  "exports": {
    "./ds/*": "./src/ds/*.tsx",
    "./components/*": "./src/components/*.tsx",
    "./charts/*": "./src/charts/*.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./icons": "./src/icons.tsx",
    "./i18n": "./src/i18n/index.tsx",
    "./styles/*": "./styles/*",
    "./tailwind-preset": "./tailwind-preset.ts",
    "./i18n/locale": "./src/i18n/locale.ts",
    "./account/*": "./src/account/*.tsx"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.62.0",
    "html-to-image": "^1.11.13",
    "next": "^16.2.10",
    "react": "^19.2.7"
  },
  "scripts": {
    "check:i18n": "node scripts/check-i18n.mjs",
    "test": "node --test tests/*.test.mjs"
  }
}
